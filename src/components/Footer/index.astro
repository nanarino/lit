---
interface Props {
    github?: string
}
---

{
    Astro.props.github && (
        <footer class="na-layout-footer">
            &nbsp; &nbsp; &nbsp; 由
            <a class="na-link" href="https://astro.build" target="_blank">
                {Astro.generator}
            </a>
            構建 &nbsp;
            <a
                class="na-link"
                title="github"
                href={Astro.props.github}
                target="_blank"
            >
                <iconify-icon
                    icon="octicon:mark-github-16"
                    style="display:inline-flex"
                />
                <i style="font-size:0">github</i>
            </a>
        </footer>
    )
}

<style>
    @property --hue-primary {
        syntax: "<number>";
        inherits: true;
        initial-value: 0;
    }

    footer {
        display: flex;
        gap: 0.5em;
        justify-content: center;
        align-items: center;
        line-height: var(--line-height-2);
        font-size: var(--font-size-2);
        color: oklch(var(--gray-8));
    }

    [title="github"] {
        --color-link: var(--lightness-6) var(--chroma-6) var(--hue-primary);
        --color-link--hover: var(--lightness-4) var(--chroma-4)
            var(--hue-primary);
        animation: hue-primary 6s linear infinite;
    }

    @keyframes hue-primary {
        from {
            --hue-primary: 0;
        }
        to {
            --hue-primary: 360;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        footer iconify-icon {
            animation: none;
        }
    }
</style>
