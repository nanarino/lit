@require '@nanarino/stylus/lib/mixins/*'
// base
@require '@nanarino/stylus/lib/variables/*'

/**
 * 使通配符引入时要确保引入的优先级 譬如：含有的 `&>*` 选择器被 `&` 覆盖
 */
@require '@nanarino/stylus/lib/common/*'
// typography / markdown
@require '@nanarino/stylus/lib/typography/*'
// components
@require '@nanarino/stylus/lib/components/*'

// custom primary
color_alias_dict = {
    primary: 'magenta',
    success: 'green',
    danger: 'red',
    warning: 'orange'
}
:root
    for k, v in color_alias_dict
        {_get_var_by('hue', k)} var(_get_var_by('hue', v))
        if k != 'primary'
            for i in range(1 10)
                {_get_var_by(k, i)} var(_get_var_by('lightness', i)) var(_get_var_by('chroma', i)) var(_get_var_by('hue', k))
            [data-primary={k}]
                {_get_var_by('hue', 'primary')} var(_get_var_by('hue', k))

    --outline-color-any--focus var(--black)
:root
[data-primary]
    mixin_primary_channels()
